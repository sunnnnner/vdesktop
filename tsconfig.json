{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "paths": { // 用于设置模块名到基于baseUrl的路径映射
        "@/*": ["./src/*"]
    }
  },
  "include": ["src/main.tsx", "src/react/**/*.ts", "src/react/**/*.tsx", "src/types/**/*.ts", "src/vite-env.d.ts"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
